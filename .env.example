# Copy this file to .env, then fill in POSTGRES_PASSWORD and N8N_RUNNERS_AUTH_TOKEN
# with long random values. This PowerShell command prints one:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })

# Postgres login used by n8n, and by you in Adminer (http://localhost:8080).
# These only apply when the database is first created. Changing them later doesn't
# change the existing database user, so n8n would fail to connect.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# n8n version, used for both the n8n and task-runner images (they must match).
# To update: change it (releases: https://github.com/n8n-io/n8n/releases),
# then run docker compose pull, then docker compose up -d.
N8N_VERSION=2.40.7

# Shared secret that n8n and the task-runner container use to talk to each other.
N8N_RUNNERS_AUTH_TOKEN=
